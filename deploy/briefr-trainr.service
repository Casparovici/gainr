[Unit]
Description=Plan next week's gym sessions into trainr's planner, with a report in briefr

[Service]
Type=oneshot
WorkingDirectory=/opt/gainr/backend
EnvironmentFile=-/etc/gainr/env
ExecStart=/opt/gainr/backend/venv/bin/python -m scripts.briefr_trainr_plan

# Same user and sandbox as gainr.service, so files the database creates (its -wal and -shm) are
# always the app's to open.
User=gainr
Group=gainr
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/gainr/backend
