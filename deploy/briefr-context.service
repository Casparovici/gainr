[Unit]
Description=Export briefr's agent context (tickers and weights) to the agents repository
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/gainr/backend
EnvironmentFile=-/etc/gainr/env
Environment=GAINR_BRIEFR_REPO_DIR=/var/lib/gainr/agents
Environment="GIT_SSH_COMMAND=ssh -i /etc/gainr/agents-deploy-key -o IdentitiesOnly=yes -o UserKnownHostsFile=/var/lib/gainr/known_hosts -o StrictHostKeyChecking=accept-new"
ExecStart=/opt/gainr/backend/venv/bin/python -m scripts.export_briefr_context --push

User=gainr
Group=gainr
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/gainr/backend
StateDirectory=gainr
CacheDirectory=gainr
Environment=XDG_CACHE_HOME=/var/cache/gainr
