[Unit]
Description=Refresh gainr prices and benchmarks, Picnic deliveries/prices, bank transactions, and Trading 212 fills, once daily

[Service]
Type=oneshot
WorkingDirectory=/opt/gainr/backend
# The same secrets the app itself runs with (Picnic, Enable Banking, Trading 212). Optional, so a
# box without bank or broker syncs set up still refreshes prices.
EnvironmentFile=-/etc/gainr/env
ExecStart=/opt/gainr/backend/venv/bin/python -m scripts.refresh_prices
ExecStart=/opt/gainr/backend/venv/bin/python -m scripts.sync_picnic
ExecStart=/opt/gainr/backend/venv/bin/python -m scripts.sync_banks
ExecStart=/opt/gainr/backend/venv/bin/python -m scripts.sync_brokers

# Same user and sandbox as gainr.service, so files the database creates (its -wal and -shm) are
# always the app's to open.
User=gainr
Group=gainr
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/gainr/backend
CacheDirectory=gainr
Environment=XDG_CACHE_HOME=/var/cache/gainr
